# Copy to .env and run: node --env-file=.env src/server.mjs
ODDS_API_KEY=
PORT=3000
CACHE_TTL_MS=300000
ODDS_MAX_AGE_MS=600000
ODDS_DAILY_CREDIT_LIMIT=12
ODDS_MIN_CREDITS_RESERVE=50

# Paid refresh stays disabled until these are separately configured by an operator.
BETQ_OPERATOR_REFRESH_TOKEN=
BETQ_BUDGET_DATABASE_URL=
BETQ_BUDGET_ACCOUNT_ID=
# Operator scripts only; optional alternate origin must be explicitly approved.
# BETQ_PRODUCTION_URL=https://betq-ai.onrender.com
# BETQ_OPERATOR_APPROVED_ORIGIN=https://betq-ai.onrender.com
